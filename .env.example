# Public application URL. Use the production domain in Vercel.
APP_URL=http://localhost:3000

# Neon pooled connection string.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Stripe test keys during development. Use a restricted key in production.
STRIPE_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Protects Vercel Cron and the admin API.
CRON_SECRET=replace_me
ADMIN_SECRET=replace_me

# Optional email delivery through Resend-compatible API.
RESEND_API_KEY=
EMAIL_FROM=夢重力マクラ <noreply@example.com>

# Optional terms page URL shown alongside the consent copy.
TERMS_URL=https://zero-g-makura.com/terms
